import { Slider } from "std-widgets.slint";


export component AppWindow inherits Window {
    background: white;

    in-out property <int> level: 12;
    property <int> max-level: 24;

    callback level-changed(int);
    callback quit();

    // Quit button
    Rectangle {
        x: root.width - self.width - root.width * 0.03;
        y: root.height * 0.02;
        width: root.width * 0.1;
        height: root.width * 0.1;
        border-width: root.width * 0.005;
        border-color: black;
        border-radius: root.width * 0.015;
        background: quit-touch.pressed ? #cccccc : white;

        quit-touch := TouchArea {
            clicked => { root.quit(); }
        }

        Text {
            text: "×";
            font-size: root.width * 0.06;
            color: black;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Absolute positioning (rather than a VerticalBox) so the proportional
    // sizes can reference root.width/root.height without forming a layout
    // binding loop — the window's content size would otherwise depend on the
    // children, which depend on the window size.
    Text {
        x: 0;
        y: root.height * 0.30;
        width: parent.width;
        text: "Frontlight";
        font-size: root.width * 0.08;
        color: black;
        horizontal-alignment: center;
    }

    Text {
        x: 0;
        y: root.height * 0.40;
        width: parent.width;
        text: root.level + " / " + root.max-level;
        font-size: root.width * 0.15;
        color: black;
        horizontal-alignment: center;
    }

    // Defer applying the level to lipc until finger release
    Slider {
        x: (root.width - self.width) / 2;
        y: root.height * 0.62;
        width: root.width * 0.9;
        height: root.height * 0.06;
        minimum: 0;
        maximum: root.max-level;
        value: root.level;
        changed(value) => {
            root.level = round(value);
        }
        released(value) => {
            root.level = round(value);
            root.level-changed(root.level);
        }
    }
}
